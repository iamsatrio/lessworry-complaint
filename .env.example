APP_NAME=Laravel

# local | staging | production.
# staging memunculkan pita "Lingkungan uji" di setiap halaman — penanda itu
# satu-satunya yang membedakan server percobaan dari yang sungguhan di layar.
APP_ENV=local

# Dibuat di server dengan `php artisan key:generate`. JANGAN disalin antar
# server: satu kunci yang sama berarti sesi dan data terenkripsi bisa dipakai
# silang antara staging dan produksi.
APP_KEY=

# WAJIB false di produksi dan di staging. Kalau true, setiap galat menampilkan
# isi variabel — termasuk kredensial NEVIRA — ke siapa pun yang memicunya.
APP_DEBUG=true

APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Nyalakan hanya setelah HTTPS hidup. Dinyalakan sebelum itu = tidak bisa login.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# NEVIRA POS integration (read-only)
# Isi dengan service account NEVIRA, bukan akun pribadi.
# Endpoint login mengikuti platform akun:
#   /admin/login  -> Back Office (dipakai service account integrasi)
#   /login        -> POS
NEVIRA_API_BASE=https://api.nevira.id/api
NEVIRA_LOGIN_ENDPOINT=/admin/login
NEVIRA_EMAIL=
NEVIRA_PASSWORD=
NEVIRA_ENABLED=false
# Lama daftar karyawan per outlet disimpan sebelum ditarik ulang (menit).
NEVIRA_OUTLET_STAFF_TTL=10
# Lama token NEVIRA disimpan sebelum login ulang (menit). Token NEVIRA berlaku
# 24 jam; angka ini sengaja jauh lebih pendek.
NEVIRA_TOKEN_TTL=55
# Batas tunggu satu panggilan NEVIRA (detik).
NEVIRA_TIMEOUT=15

# Backup database — `php artisan backup:database`, dijadwalkan harian.
# Direktori tujuan dump. Kosongkan untuk memakai storage/app/backups.
# HANYA isi direktori ini yang dihapus rotasi, jadi jangan mengarahkannya ke
# direktori yang juga dipakai hal lain.
BACKUP_PATH=
# Berapa dump terakhir yang disimpan; yang lebih tua dibuang setelah dump baru
# berhasil.
BACKUP_KEEP=7
# Isi kalau binari MySQL tidak ada di PATH milik cron.
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
# Batas waktu satu dump/restore (detik).
BACKUP_TIMEOUT=900
